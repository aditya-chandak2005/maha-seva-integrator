PROJECT_NAME="Maha-Seva Integrator"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/maha_seva

# Security & JWT Configuration
JWT_SECRET=maha-seva-super-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Document Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Government Integration Mode (True = Safe Mock Adapters for SIH Demo)
ENABLE_MOCK_GOV_INTEGRATIONS=True

# Google Gemini API Key for Smart AI Assistant
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
